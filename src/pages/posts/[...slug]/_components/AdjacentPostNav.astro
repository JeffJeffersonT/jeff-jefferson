---
import { getPostUrl } from "@/utils/getPostPaths";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<nav data-pagefind-ignore class="webring" aria-label="other posts">
  <span class="webring-prev">
    {
      prevPost ? (
        <a href={getPostUrl(prevPost.id, prevPost.filePath, locale)}>
          &laquo; {prevPost.title}
        </a>
      ) : (
        <span class="muted">« the end</span>
      )
    }
  </span>
  <span class="webring-home">
    <a href={getRelativeLocaleUrl(locale, "posts")}>all posts</a>
  </span>
  <span class="webring-next">
    {
      nextPost ? (
        <a href={getPostUrl(nextPost.id, nextPost.filePath, locale)}>
          {nextPost.title} &raquo;
        </a>
      ) : (
        <span class="muted">the start »</span>
      )
    }
  </span>
</nav>
