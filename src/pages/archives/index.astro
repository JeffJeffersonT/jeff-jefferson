---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection, type CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { postFilter } from "@/utils/postFilter";
import { resolveTimezone } from "@/utils/resolveTimezone";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const locale = Astro.currentLocale ?? config.site.lang;

const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getCollection("posts");
const filteredPosts = posts.filter(postFilter);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });

const publishDate = (post: CollectionEntry<"posts">) =>
  dayjs(post.data.pubDatetime).tz(
    resolveTimezone(post.data.timezone ?? config.site.timezone)
  );

const years = Object.entries(
  getPostsByGroupCondition(filteredPosts, post => publishDate(post).year())
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc="all my posts, sorted by year and month.">
    {
      years.length > 0 ? (
        <table class="archive-table">
          <thead>
            <tr>
              <th>year</th>
              <th>month</th>
              <th>post</th>
              <th>posted</th>
            </tr>
          </thead>
          <tbody>
            {years.map(([year, yearGroup]) => {
              const months = Object.entries(
                getPostsByGroupCondition(
                  yearGroup,
                  post => publishDate(post).month() + 1
                )
              ).sort(([a], [b]) => Number(b) - Number(a));
              return months.flatMap(([month, monthGroup], monthIdx) => {
                const monthName = monthFormatter
                  .format(new Date(2000, Number(month) - 1, 1))
                  .toLowerCase();
                const sorted = [...monthGroup].sort(
                  (a, b) =>
                    new Date(b.data.pubDatetime).getTime() -
                    new Date(a.data.pubDatetime).getTime()
                );
                return sorted.map((post, postIdx) => {
                  const when = publishDate(post);
                  return (
                    <tr>
                      {monthIdx === 0 && postIdx === 0 && (
                        <td rowspan={yearGroup.length} class="yr">
                          {year}
                        </td>
                      )}
                      {postIdx === 0 && (
                        <td rowspan={sorted.length} class="mo">
                          {monthName}
                        </td>
                      )}
                      <td>
                        <a href={getPostUrl(post.id, post.filePath, locale)}>
                          {post.data.title}
                        </a>
                      </td>
                      <td class="when">{when.format("D MMM YYYY").toLowerCase()}</td>
                    </tr>
                  );
                });
              });
            })}
          </tbody>
        </table>
      ) : (
        <p>nothing here yet. check back soon!</p>
      )
    }
  </Main>
</Layout>
