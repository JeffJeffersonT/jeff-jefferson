---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import BannerRow from "@/components/BannerRow.astro";
import { banners, buttons, blinkies, stamps, gifs } from "@/data/banners";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const siteUrl = new URL(getAssetPath(""), Astro.site).href.replace(/\/?$/, "/");
const buttonUrl = new URL(getAssetPath("buttons/jeff-jefferson.gif"), Astro.site).href;

const snippet = `<a href="${siteUrl}" target="_blank"><img src="${buttonUrl}" alt="jeff jefferson" width="88" height="31" border="0"></a>`;

const pageTitle = "goodies";
const pageDesc = "buttons, blinkies, stamps and gifs i've picked up around the web.";
const empty =
  banners.length + buttons.length + blinkies.length + stamps.length + gifs.length === 0;
---

<Layout title={`${pageTitle} | ${config.site.title}`} description={pageDesc}>
  <Breadcrumb />

  <Main pageTitle="take some of mine" class="app-prose goodies">
    <p>
      buttons, blinkies, stamps and gifs i've picked up around the web. click
      one to go to where it came from. if you want any for your own site, right
      click and save them, please don't hotlink :)
    </p>

    <h2>link to me!</h2>
    <p>
      if you like it here, you can put my button on your site. it'd make me
      really happy :)
    </p>
    <p class="center">
      <a href={siteUrl}>
        <img
          src={buttonUrl}
          alt="jeff jefferson"
          width="88"
          height="31"
          class="goodie-img btn-88"
        />
      </a>
    </p>
    <p>copy this into your page, or just save the button and use your own link</p>
    <p>
      <textarea
        class="snippet"
        rows="4"
        readonly
        onclick="this.select()"
        aria-label="html for my 88x31 button">{snippet}</textarea>
    </p>

    {empty && <p class="muted">(nothing here yet, coming soon)</p>}

    {
      buttons.length > 0 && (
        <section>
          <h2>buttons</h2>
          <BannerRow items={buttons} kind="buttons" />
        </section>
      )
    }

    {
      blinkies.length > 0 && (
        <section>
          <h2>blinkies</h2>
          <BannerRow items={blinkies} kind="blinkies" />
        </section>
      )
    }

    {
      stamps.length > 0 && (
        <section>
          <h2>stamps</h2>
          <BannerRow items={stamps} kind="stamps" />
        </section>
      )
    }

    {
      gifs.length > 0 && (
        <section>
          <h2>gifs</h2>
          <BannerRow items={gifs} kind="banners" />
        </section>
      )
    }

    {
      banners.length > 0 && (
        <section>
          <h2>banners</h2>
          <BannerRow items={banners} kind="banners" />
        </section>
      )
    }

    <hr />
    <p class="small">
      want to trade buttons? link to me with the code above and tell me, i'll
      add yours :)
    </p>
  </Main>
</Layout>
