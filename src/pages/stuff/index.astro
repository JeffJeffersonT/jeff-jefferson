---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import WinBox from "@/components/WinBox.astro";
import { creationSections } from "@/data/creations";
import config from "@/config";

const pageDesc = "photography, videography, graphic design, art, voice work and game dev.";
---

<Layout title={`my stuff | ${config.site.title}`} description={pageDesc}>
  <Breadcrumb />

  <Main pageTitle="my stuff" class="app-prose" accent="/gifs/tiny-star.gif">
    <p>
      things i make. each room starts empty, and i'll fill it when i have
      something real to show.
    </p>

    {
      creationSections.map(sec => (
        <WinBox title={sec.title} class="stack-win">
          <p>{sec.blurb}</p>
          <p>
            <a href={`/stuff/${sec.key}/`}>{sec.title} &raquo;</a>
            {sec.items.length === 0 && <span class="muted"> (coming soon)</span>}
            {sec.items.length > 0 && (
              <span class="muted"> ({sec.items.length})</span>
            )}
          </p>
        </WinBox>
      ))
    }
  </Main>
</Layout>
