---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const pageDesc = "how this site is put together.";
const buttonSrc = getAssetPath("buttons/jeff-jefferson.gif");
---

<Layout title={`about this site | ${config.site.title}`} description={pageDesc}>
  <Breadcrumb />

  <Main pageTitle="about this site" class="app-prose">
    <p>
      jeffersons.space is my little corner of the internet. i write posts,
      collect buttons and gifs, and leave room for shrines and photos as i go.
    </p>
    <p>
      it is a static site, built with Astro and hosted on GitHub Pages. the
      guestbook and the comments on posts talk to a small Cloudflare Worker.
      there are no accounts to make.
    </p>
    <p>
      pictures on the site have their metadata stripped before they go up, and
      gif animations are kept. if you want to use my 88 by 31 button, the code
      is on the <a href="/goodies/">goodies</a> page.
    </p>
    <p class="center">
      <a href="/">
        <img src={buttonSrc} alt="jeff jefferson" width="88" height="31" />
      </a>
    </p>
    <p>
      the look is meant to feel like a handmade page from the earlier web.
      night mode is there if you want it.
    </p>
    <p>
      if you want to say hi, you can email me at{" "}
      <a href="mailto:jeffjefferson@duck.com">jeffjefferson@duck.com</a>, or{" "}
      <a href="/guestbook/">sign the guestbook</a>.
    </p>
  </Main>
</Layout>
