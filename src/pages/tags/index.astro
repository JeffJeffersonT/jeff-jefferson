---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@/utils/slugify";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const counts = tags.map(({ tag, tagName }) => ({
  tag,
  tagName,
  count: posts.filter(p => p.data.tags.some(x => slugifyStr(x) === tag)).length,
}));
const min = counts.length ? Math.min(...counts.map(c => c.count)) : 1;
const max = counts.length ? Math.max(...counts.map(c => c.count)) : 1;
const sizeFor = (count: number) =>
  max === min ? 16 : 12 + Math.round((10 * (count - min)) / (max - min));
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc="a cloud of the tags on my posts. bigger type means more posts.">
    {
      counts.length > 0 ? (
        <ul class="tag-cloud">
          {counts.map(({ tag, tagName, count }) => (
            <li style={`font-size: ${sizeFor(count)}px`}>
              <a href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}>#{tagName}</a>
              <span class="count">({count})</span>
            </li>
          ))}
        </ul>
      ) : (
        <p>no tags yet!</p>
      )
    }
  </Main>
</Layout>
