---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Favourites from "@/components/Favourites.astro";
import { minibuttons } from "@/data/minibuttons";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <div class="currently">
      <b>currently</b>
      <span>editing photos</span>
    </div>
    <Content />
    {
      minibuttons.length > 0 && (
        <div class="mini-row">
          {minibuttons.map(b => {
            const img = (
              <img
                src={getAssetPath(b.src)}
                alt={b.alt}
                width={b.width}
                height={b.height}
                loading="lazy"
              />
            );
            return b.href ? (
              <a href={b.href} target="_blank" rel="noopener noreferrer">
                {img}
              </a>
            ) : (
              img
            );
          })}
        </div>
      )
    }
    <Favourites />
  </Main>
</Layout>
