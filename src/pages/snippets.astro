---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import BannerRow from "@/components/BannerRow.astro";
import { banners, buttons, blinkies, gifs } from "@/data/banners";
import config from "@/config";

const pageTitle = "snippets";
const pageDesc = "buttons, blinkies and gifs i've picked up around the web.";
const empty =
  banners.length + buttons.length + blinkies.length + gifs.length === 0;
---

<Layout title={`${pageTitle} | ${config.site.title}`} description={pageDesc}>
  <Breadcrumb />

  <Main pageTitle="snippets from other corners of the internet" class="app-prose">
    <p>
      buttons, blinkies and gifs i've picked up around the web. click one to
      go to where it came from.
    </p>

    {empty && <p class="muted">(nothing here yet, coming soon)</p>}

    {
      buttons.length > 0 && (
        <section>
          <h2>buttons</h2>
          <BannerRow items={buttons} kind="buttons" />
        </section>
      )
    }

    <section>
      <h2>blinkies</h2>
      {
        blinkies.length > 0 ? (
          <BannerRow items={blinkies} kind="blinkies" />
        ) : (
          <p class="muted">(none yet)</p>
        )
      }
    </section>

    {
      gifs.length > 0 && (
        <section>
          <h2>gifs</h2>
          <BannerRow items={gifs} kind="banners" />
        </section>
      )
    }

    {
      banners.length > 0 && (
        <section>
          <h2>banners</h2>
          <BannerRow items={banners} kind="banners" />
        </section>
      )
    }
  </Main>
</Layout>
