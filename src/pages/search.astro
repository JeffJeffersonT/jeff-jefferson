---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const pagefindBundlePath = getAssetPath("pagefind/");
const t = useTranslations(locale);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Breadcrumb />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc} class="app-prose">
    <div id="search-root" data-bundle-path={pagefindBundlePath}>
      <form id="search-form" class="search-form" role="search">
        <label for="q"><b>search for:</b></label>
        <input id="q" name="q" type="search" autocomplete="off" placeholder="a word or two" />
        <button type="submit" class="win-btn">go!</button>
      </form>
      <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
      <ul id="search-results" class="search-results"></ul>
    </div>
  </Main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>("#search-root");
  if (root) {
    const bundle = root.dataset.bundlePath ?? "/pagefind/";
    const form = root.querySelector<HTMLFormElement>("#search-form")!;
    const input = root.querySelector<HTMLInputElement>("#q")!;
    const status = root.querySelector<HTMLElement>("#search-status")!;
    const out = root.querySelector<HTMLUListElement>("#search-results")!;

    type PF = {
      options: (o: Record<string, unknown>) => Promise<void>;
      search: (q: string) => Promise<{
        results: {
          data: () => Promise<{
            url: string;
            excerpt: string;
            meta: { title?: string };
          }>;
        }[];
      }>;
    };
    let pf: PF | null = null;
    const load = async () => {
      if (pf) return pf;
      const mod = await import(/* @vite-ignore */ `${bundle}pagefind.js`);
      await mod.options({ baseUrl: "/" });
      pf = mod as PF;
      return pf;
    };

    // pagefind excerpts only contain <mark>; escape everything else.
    const safeExcerpt = (html: string) =>
      html
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/&lt;mark&gt;/g, "<mark>")
        .replace(/&lt;\/mark&gt;/g, "</mark>");

    const run = async (q: string) => {
      out.textContent = "";
      const term = q.trim();
      if (!term) {
        status.textContent = "";
        return;
      }
      status.textContent = "searching...";
      try {
        const engine = await load();
        const res = await engine.search(term);
        const items = await Promise.all(
          res.results.slice(0, 20).map(r => r.data())
        );
        if (items.length === 0) {
          status.textContent = `nothing found for "${term}". try different words?`;
          return;
        }
        status.textContent = `found ${res.results.length} ${
          res.results.length === 1 ? "page" : "pages"
        } for "${term}":`;
        items.forEach(it => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.className = "res-title";
          a.href = it.url;
          a.textContent = it.meta.title ?? it.url;
          const p = document.createElement("p");
          p.className = "res-excerpt";
          p.innerHTML = safeExcerpt(it.excerpt);
          li.append(a, p);
          out.append(li);
        });
      } catch {
        status.textContent =
          "search isn't available right now (the index only exists on the built site).";
      }
    };

    form.addEventListener("submit", e => {
      e.preventDefault();
      const q = input.value;
      const url = new URL(window.location.href);
      if (q.trim()) url.searchParams.set("q", q.trim());
      else url.searchParams.delete("q");
      history.replaceState(null, "", url);
      run(q);
    });

    const initial = new URLSearchParams(window.location.search).get("q");
    if (initial) {
      input.value = initial;
      run(initial);
    }
  }
</script>
