---
import Layout from "@/layouts/Layout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <main id="main-content" class="center">
    <p class="big-404">404</p>
    <p>oops! that page wandered off somewhere. (error 404: file not found)</p>
    <p>
      <a href={getRelativeLocaleUrl(locale, "")}>take me back home &raquo;</a>
    </p>
  </main>
</Layout>
