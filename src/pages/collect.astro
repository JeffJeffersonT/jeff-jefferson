---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { categories, type Goodie } from "@/data/goodies";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const siteUrl = new URL(getAssetPath(""), Astro.site).href.replace(/\/?$/, "/");
const buttonUrl = new URL(getAssetPath("buttons/jeff-jefferson.gif"), Astro.site).href;

const snippet = `<a href="${siteUrl}" target="_blank"><img src="${buttonUrl}" alt="jeff jefferson" width="88" height="31" border="0"></a>`;

const resolveSrc = (src: string) =>
  /^(https?:)?\/\//.test(src) ? src : getAssetPath(src);

const pageTitle = "goodies";
const pageDesc = "little things i've collected from around the web, free to grab.";
const items = (list: Goodie[]) => list.map(g => ({ ...g, src: resolveSrc(g.src) }));
---

<Layout title={`${pageTitle} | ${config.site.title}`} description={pageDesc}>
  <Breadcrumb />

  <Main pageTitle="take some of mine" class="app-prose goodies">
    <p>
      hey, these are some of the little things i've collected. feel free to
      grab some for your own corner of the internet :)
    </p>
    <p class="goodies-note">
      <b>right click and save, please don't hotlink :)</b>
    </p>

    <h2>link to me!</h2>
    <p>
      if you like it here, you can put my button on your site. it'd make me
      really happy :)
    </p>
    <p class="center">
      <a href={siteUrl}>
        <img
          src={buttonUrl}
          alt="jeff jefferson"
          width="88"
          height="31"
          class="goodie-img"
        />
      </a>
    </p>
    <p>copy this into your page (or just save the button and use your own link):</p>
    <p>
      <textarea
        class="snippet"
        rows="4"
        readonly
        onclick="this.select()"
        aria-label="html for my 88x31 button">{snippet}</textarea>
    </p>

    {
      categories.map(cat => (
        <section id={cat.key}>
          <h2>
            {cat.title} <span class="small">({cat.blurb})</span>
          </h2>
          {cat.items.length === 0 ? (
            <p class="muted">(nothing here yet, coming soon)</p>
          ) : (
            <div class="goodie-grid">
              {items(cat.items).map(g => {
                const img = (
                  <img
                    src={g.src}
                    alt={g.alt}
                    width={g.width}
                    height={g.height}
                    loading="lazy"
                    class="goodie-img"
                  />
                );
                return (
                  <figure class="goodie">
                    {g.href ? (
                      <a href={g.href} target="_blank" rel="noopener noreferrer">
                        {img}
                      </a>
                    ) : (
                      img
                    )}
                    {g.credit && <figcaption>{g.credit}</figcaption>}
                  </figure>
                );
              })}
            </div>
          )}
        </section>
      ))
    }

    <hr />
    <p class="small">
      want to trade buttons? link to me with the code above and tell me, i'll
      add yours :)
    </p>
  </Main>
</Layout>
