---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <main id="main-content" data-home-path={homePath} class="hello">
    <h2>welcome!</h2>
    <p>i write about the things i like. hope you have a nice day :)</p>
    <p>
      this is my little corner of the internet. look around, read a post or
      two, and make yourself at home. you can also{" "}
      <a href={getAssetPath("rss.xml")} title="RSS Feed">follow along with rss</a>.
    </p>
    <p><span class="construction">*** under construction: always a work in progress ***</span></p>
    <hr />

    {
      featuredPosts.length > 0 && (
        <>
          <h2>featured</h2>
          <ul class="post-list">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </>
      )
    }

    <h2 id="recent-posts">latest posts</h2>
    {
      recentPosts.length > 0 ? (
        <ul class="post-list">
          {recentPosts.slice(0, postsConfig.perIndex).map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
      ) : (
        featuredPosts.length === 0 && (
          <p>no posts yet, but i'm working on it. check back soon!</p>
        )
      )
    }
    <p><a href={getRelativeLocaleUrl(locale, "posts")}>see all posts &raquo;</a></p>
  </main>
</Layout>

<script>
  const homePath = document.querySelector<HTMLElement>("#main-content")?.dataset
    .homePath;
  sessionStorage.setItem(
    "backUrl",
    homePath ?? import.meta.env.BASE_URL.replace(/\/?$/, "/")
  );
</script>
