---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import WinBox from "@/components/WinBox.astro";
import { collections } from "@/data/collections";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const pageDesc = "shows, games, music and card games i like.";
---

<Layout title={`stuff i like | ${config.site.title}`} description={pageDesc}>
  <Breadcrumb />

  <Main pageTitle="stuff i like" class="app-prose" accent="/gifs/tiny-star.gif">
    <p>
      a running list of things i like, with pictures. some of the same
      covers also live on the <a href="/about/">about</a> page.
    </p>

    {
      collections.length === 0 ? (
        <p class="muted">nothing here yet.</p>
      ) : (
        collections.map(col => (
          <WinBox title={col.title} class="stack-win wide-win">
            {col.items.length === 0 ? (
              <p class="muted">nothing in this list yet.</p>
            ) : (
              <ul class="like-grid">
                {col.items.map(item => (
                  <li>
                    {item.src ? (
                      <img
                        src={getAssetPath(item.src)}
                        alt={item.note ? `${item.name} by ${item.note}` : item.name}
                        width="160"
                        height="160"
                        loading="lazy"
                      />
                    ) : (
                      <span class="like-tile">{item.name}</span>
                    )}
                    {item.href ? (
                      <a class="title" href={item.href}>
                        {item.name}
                      </a>
                    ) : (
                      <span class="title">{item.name}</span>
                    )}
                    {item.note ? <span class="note">{item.note}</span> : null}
                  </li>
                ))}
              </ul>
            )}
          </WinBox>
        ))
      )
    }
  </Main>
</Layout>
