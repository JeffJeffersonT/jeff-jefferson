---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { updates } from "@/data/updates";
import { counter } from "@/data/services";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const recent = posts.slice(0, 5);
const placeholder = "-".repeat(counter.digits);
---

<aside class="side-col" aria-label="sidebar" data-pagefind-ignore>
  <div class="box">
    <div class="win" role="region" aria-label="updates">
      <div class="win-title">updates.txt</div>
      <div class="win-body">
        <ul>
          {
            updates.slice(0, 3).map(u => (
              <li>
                <b>{u.date}</b>
                <br />
                {u.text}
              </li>
            ))
          }
        </ul>
        {
          updates.length > 3 && (
            <p class="see-more">
              <a href={getRelativeLocaleUrl(locale, "updates")}>more updates...</a>
            </p>
          )
        }
      </div>
    </div>
  </div>

  <div class="box">
    <h2 class="strip">about me</h2>
    <p>
      hi, i'm jeff! this is my little corner of the internet where i write about
      the things i like. <a href={getRelativeLocaleUrl(locale, "about")}>more...</a>
    </p>
  </div>

  <div class="box">
    <h2 class="strip">recent posts</h2>
    {
      recent.length > 0 ? (
        <ul>
          {recent.map(post => (
            <li>
              <a href={getPostUrl(post.id, post.filePath, locale)}>
                {post.data.title}
              </a>{" "}
              <span
                class="new-badge"
                data-pub={new Date(post.data.pubDatetime).toISOString()}
              >
                new!
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">(no posts yet, check back soon!)</p>
      )
    }
  </div>

  <div class="box">
    <h2 class="strip">say hi</h2>
    <p>
      thanks for stopping by :) leave a note in the
      {" "}<a href={getRelativeLocaleUrl(locale, "guestbook")}>guestbook</a>, i'd
      love to hear from you!
    </p>
  </div>

  <div class="box">
    <h2 class="strip">visitors</h2>
    <p class="center">
      <span
        class="counter"
        id="visit-counter"
        data-digits={counter.digits}
        data-api={counter.api}
        data-ns={counter.namespace}
        data-key={counter.key}
        role="img"
        aria-label="visitor counter">{placeholder}</span>
      <br />
      <span class="small" id="visit-note">you are visitor number...</span>
    </p>
  </div>
</aside>
