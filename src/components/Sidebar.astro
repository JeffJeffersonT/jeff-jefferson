---
import { getRelativeLocaleUrl } from "astro:i18n";
import { updates } from "@/data/updates";
import { counter } from "@/data/services";
import { guestbook } from "@/data/guestbook";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const placeholder = "-".repeat(counter.digits);
const { features } = config;
const endpoint = guestbook.endpoint;
---

<aside class="side-col" aria-label="sidebar" data-pagefind-ignore>
  <div class="box">
    <div class="win" role="region" aria-label="updates">
      <div class="win-title">updates.txt</div>
      <div class="win-body">
        <ul>
          {
            updates.slice(0, 3).map(u => (
              <li>
                <b>{u.date}</b>
                <br />
                {u.text}
              </li>
            ))
          }
        </ul>
        {
          updates.length > 3 && (
            <p class="see-more">
              <a href={getRelativeLocaleUrl(locale, "updates")}>more updates...</a>
            </p>
          )
        }
      </div>
    </div>
  </div>

  <div class="box">
    <h2 class="strip">say hi</h2>
    <p class="say-hi">
      <a href={getRelativeLocaleUrl(locale, "guestbook")}>
        <img
          src={getAssetPath("/buttons/sign-guestbook.gif")}
          alt="sign my guestbook"
          width="88"
          height="31"
        />
      </a>
      <a href="mailto:jeffjefferson@duck.com">
        <img
          src={getAssetPath("/buttons/email-me.gif")}
          alt="email me"
          width="88"
          height="31"
        />
      </a>
    </p>
  </div>

  <div class="box pet-box">
    <h2 class="strip">a little friend</h2>
    <p class="center">
      <img
        src={getAssetPath("/pets/pixel-friend.gif")}
        alt="a little purple pixel creature"
        width="48"
        height="48"
      />
    </p>
  </div>

  <div class="box shout-box" id="shoutbox" data-endpoint={endpoint} data-max-name="40" data-max-message="160">
    <h2 class="strip">shoutbox</h2>
    <ol id="shout-list" class="shout-list"></ol>
    <p id="shout-empty" class="muted small">no shouts yet. say hi!</p>
    <form id="shout-form" class="shout-form">
      <label>
        name
        <input type="text" name="name" maxlength="40" required autocomplete="nickname" />
      </label>
      <label>
        shout
        <input type="text" name="message" maxlength="160" required />
      </label>
      <label class="hp" aria-hidden="true">
        nickname
        <input type="text" name="nickname" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit" class="win-btn">shout</button>
      <p id="shout-status" class="shout-status" role="status"></p>
    </form>
  </div>

  <div class="box">
    <h2 class="strip">visitors</h2>
    <p class="center">
      <span
        class="counter"
        id="visit-counter"
        data-digits={counter.digits}
        data-api={counter.api}
        data-ns={counter.namespace}
        data-key={counter.key}
        role="img"
        aria-label="visitor counter">{placeholder}</span>
      <br />
      <span class="small" id="visit-note">you are visitor number...</span>
    </p>
  </div>

  {
    features.lightAndDarkMode && (
      <div class="box">
        <h2 class="strip">night mode</h2>
        <div class="btn-wrap">
          <button
            id="theme-btn"
            class="win-btn"
            type="button"
            title="switch between day and night mode"
            aria-label="auto"
          >
            <span class="day-label">night mode</span>
            <span class="night-label">day mode</span>
          </button>
        </div>
      </div>
    )
  }

  <div class="box sparkle-box">
    <h2 class="strip">sparkles</h2>
    <div class="btn-wrap">
      <button
        id="sparkle-btn"
        class="win-btn"
        type="button"
        aria-pressed="true"
        title="turn the cursor sparkles on or off"
      >
        <span class="spark-off">turn sparkles off</span>
        <span class="spark-on" hidden>turn sparkles on</span>
      </button>
    </div>
  </div>

</aside>
