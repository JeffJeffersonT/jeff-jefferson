---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import BannerRow from "@/components/BannerRow.astro";
import { banners, buttons } from "@/data/banners";
import config from "@/config";

type Props = HTMLAttributes<"footer">;

const { class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
const lastUpdated = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
})
  .format(new Date())
  .toLowerCase();

const PREVIEW_BUTTONS = 8;
const PREVIEW_BANNERS = 2;
const previewBanners = banners.slice(0, PREVIEW_BANNERS);
const previewButtons = buttons.slice(0, PREVIEW_BUTTONS);
const hasBanners = previewBanners.length > 0;
const hasButtons = previewButtons.length > 0;
const hasMore =
  banners.length > PREVIEW_BANNERS || buttons.length > PREVIEW_BUTTONS;
const snippetsHref = getRelativeLocaleUrl(locale, "snippets");
---

<footer class:list={["site-footer", className]} {...attrs}>
  <section aria-label="snippets from other corners of the internet">
    <h2>snippets from other corners of the internet</h2>
    {!hasBanners && !hasButtons && <p class="soon">(more coming soon)</p>}
    {hasBanners && <BannerRow items={previewBanners} kind="banners" />}
    {hasButtons && <BannerRow items={previewButtons} kind="buttons" />}
    {hasMore && (
      <p class="see-more">
        <a href={snippetsHref}>see more &raquo;</a>
      </p>
    )}
  </section>
  <hr />
  <p>
    best viewed with any browser at 800x600 &middot; no frames, no flash,
    just html
  </p>
  <p>
    last updated: {lastUpdated} &middot; &copy; {currentYear}{" "}
    {config.site.author} &middot; made by hand &middot;{" "}
    <a href="#top">back to top</a>
  </p>
</footer>
