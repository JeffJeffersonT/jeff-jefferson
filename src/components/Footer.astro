---
import type { HTMLAttributes } from "astro/types";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = HTMLAttributes<"footer">;

const { class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={["site-footer", className]} {...attrs}>
  <p>
    &copy; {currentYear}{" "}
    {config.site.author} &middot; made by hand &middot; best viewed in any
    browser &middot;{" "}
    <a href="/map/">site map</a> &middot;{" "}
    <a href="/colophon/">about this site</a> &middot;{" "}
    <a href="#top" class="to-top">
      <img
        src={getAssetPath("gifs/to-top.png")}
        alt=""
        width="16"
        height="16"
      />
      back to top
    </a>
  </p>
</footer>
