---
import type { HTMLAttributes } from "astro/types";
import { getAssetPath } from "@/utils/withBase";
import { banners, buttons, type Banner } from "@/data/banners";
import config from "@/config";

type Props = HTMLAttributes<"footer">;

const { class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();

const resolveSrc = (src: string) =>
  /^(https?:)?\/\//.test(src) ? src : getAssetPath(src);

// Strip stray base-less hrefs/srcs gracefully; render nothing when empty.
const hasBanners = banners.length > 0;
const hasButtons = buttons.length > 0;

const renderable = (items: Banner[]) =>
  items.map(b => ({
    ...b,
    src: resolveSrc(b.src),
  }));
const bannerItems = renderable(banners);
const buttonItems = renderable(buttons);
---

<footer class:list={["site-footer", className]} {...attrs}>
  {
    (hasBanners || hasButtons) && (
      <section class="footer-section" aria-label="banners and buttons">
        <h2>~ banners / buttons ~</h2>
        {hasBanners && (
          <div class="banner-row">
            {bannerItems.map(b => {
              const img = (
                <img
                  src={b.src}
                  alt={b.alt}
                  width={b.width}
                  height={b.height}
                  loading="lazy"
                />
              );
              return b.href ? (
                <a href={b.href} target="_blank" rel="noopener noreferrer">
                  {img}
                </a>
              ) : (
                img
              );
            })}
          </div>
        )}
        {hasButtons && (
          <div class="banner-row buttons" style="margin-top: 8px;">
            {buttonItems.map(b => {
              const img = (
                <img
                  src={b.src}
                  alt={b.alt}
                  width={b.width ?? 88}
                  height={b.height ?? 31}
                  loading="lazy"
                />
              );
              return b.href ? (
                <a href={b.href} target="_blank" rel="noopener noreferrer">
                  {img}
                </a>
              ) : (
                img
              );
            })}
          </div>
        )}
      </section>
    )
  }
  <p class="best-viewed">
    &#9733; best viewed in any browser, at any size, on any day &#9733;
  </p>
  <p>
    &copy; {currentYear}{" "}
    {config.site.author} &middot; made by hand with a little love &middot;
    thanks for visiting, come back soon!
  </p>
</footer>
