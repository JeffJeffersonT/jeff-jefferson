---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="pager" aria-label="Pagination Navigation">
      {page.url.prev ? (
        <a class="win-btn" href={page.url.prev}>&laquo; prev</a>
      ) : (
        <span class="win-btn is-off">&laquo; prev</span>
      )}
      page {page.currentPage} of {page.lastPage}
      {page.url.next ? (
        <a class="win-btn" href={page.url.next}>next &raquo;</a>
      ) : (
        <span class="win-btn is-off">next &raquo;</span>
      )}
    </nav>
  )
}
