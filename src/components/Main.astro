---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  accent?: string;
};

const { pageTitle, pageDesc, class: className, accent } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main data-backUrl={backUrl} id="main-content" class:list={[className]}>
  <h1>
    {pageTitle}
    {
      accent && (
        <img
          class="heading-gif"
          src={getAssetPath(accent)}
          alt=""
          width="13"
          height="13"
        />
      )
    }
  </h1>
  {pageDesc && <p class="page-desc">{pageDesc}</p>}
  <slot />
</main>

<script>
  const backUrl = document.querySelector<HTMLElement>("#main-content")?.dataset
    ?.backurl;
  if (backUrl) {
    sessionStorage.setItem("backUrl", backUrl);
  }
</script>
