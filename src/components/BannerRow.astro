---
import type { Banner } from "@/data/banners";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  items: Banner[];
  kind?: "banners" | "buttons" | "blinkies";
};

const { items, kind = "banners" } = Astro.props;

const resolveSrc = (src: string) =>
  /^(https?:)?\/\//.test(src) ? src : getAssetPath(src);

const defaultSize =
  kind === "buttons" ? { width: 88, height: 31 } : kind === "blinkies" ? { width: 150, height: 20 } : {};
---

{
  items.length > 0 && (
    <div class:list={["banner-row", kind !== "banners" && kind]}>
      {items.map(b => {
        const width = b.width ?? defaultSize.width;
        const height = b.height ?? defaultSize.height;
        const img = (
          <img
            src={resolveSrc(b.src)}
            alt={b.alt}
            width={width}
            height={height}
            loading="lazy"
          />
        );
        return b.href ? (
          <a href={b.href} target="_blank" rel="noopener noreferrer">
            {img}
          </a>
        ) : (
          img
        );
      })}
    </div>
  )
}
