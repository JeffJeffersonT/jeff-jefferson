---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}>#{tagName}</a>
</li>
