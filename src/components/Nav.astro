---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { resolveTimezone } from "@/utils/resolveTimezone";
import { stripBase, stripLocale, getAssetPath } from "@/utils/withBase";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const { features } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const relativePath = stripBase(Astro.url.pathname);
const currentPath = stripLocale(
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath,
  locale
);
const isActive = (path: string) => {
  const current = currentPath.split("/").filter(p => p.trim());
  const target = path.split("/").filter(p => p.trim());
  if (target.length === 0) return current.length === 0;
  return current[0] === target[0];
};

const links = [
  { href: getRelativeLocaleUrl(locale, ""), label: "home", path: "/" },
  { href: getRelativeLocaleUrl(locale, "posts"), label: "posts", path: "/posts" },
  { href: getRelativeLocaleUrl(locale, "tags"), label: "tags", path: "/tags" },
  ...(features.showArchives
    ? [{ href: getRelativeLocaleUrl(locale, "archives"), label: "archives", path: "/archives" }]
    : []),
  { href: getRelativeLocaleUrl(locale, "guestbook"), label: "guestbook", path: "/guestbook" },
  { href: getRelativeLocaleUrl(locale, "collect"), label: "goodies", path: "/collect" },
  { href: getRelativeLocaleUrl(locale, "links"), label: "cool sites", path: "/links" },
  { href: getRelativeLocaleUrl(locale, "about"), label: "about me", path: "/about" },
  ...(features.search !== false
    ? [{ href: getRelativeLocaleUrl(locale, "search"), label: "search", path: "/search" }]
    : []),
  { href: getRelativeLocaleUrl(locale, "random"), label: "random post", path: "/random" },
  { href: getAssetPath("rss.xml"), label: "rss feed", path: "/rss.xml" },
];

const posts = getSortedPosts(await getCollection("posts"));

const tagCounts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = slugifyStr(tag);
    const entry = tagCounts.get(slug);
    if (entry) entry.count += 1;
    else tagCounts.set(slug, { name: tag, count: 1 });
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const months = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  const d = dayjs(post.data.pubDatetime).tz(
    resolveTimezone(post.data.timezone ?? config.site.timezone)
  );
  const key = d.format("YYYY-MM");
  const existing = months.get(key);
  if (existing) existing.count += 1;
  else months.set(key, { label: d.format("MMM YYYY").toLowerCase(), count: 1 });
}
const archive = [...months.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const archivesUrl = getRelativeLocaleUrl(locale, "archives");
---

<aside class="nav-col" aria-label="navigation" data-pagefind-ignore>
  <h2 class="strip">navigation</h2>
  <ul class="links">
    {
      links.map(link => (
        <li aria-current={isActive(link.path) ? "page" : undefined}>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>

  <h2 class="strip hide-phone">tags</h2>
  {
    tags.length > 0 ? (
      <ul class="tag-links hide-phone">
        {tags.map(([slug, { name, count }]) => (
          <li>
            <a href={getRelativeLocaleUrl(locale, `tags/${slug}/`)}>{name}</a>{" "}
            <span class="count">({count})</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted hide-phone">(none yet)</p>
    )
  }

  <h2 class="strip hide-phone">archive</h2>
  {
    archive.length > 0 ? (
      <ul class="archive-links hide-phone">
        {archive.map(([key, { label, count }]) => (
          <li>
            <a href={`${archivesUrl}#m-${key}`}>{label}</a>{" "}
            <span class="count">({count})</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted hide-phone">(empty for now)</p>
    )
  }

  {
    features.lightAndDarkMode && (
      <>
        <h2 class="strip">display</h2>
        <div class="btn-wrap">
          <button
            id="theme-btn"
            class="win-btn"
            type="button"
            title="switch between day and night mode"
            aria-label="auto"
          >
            <span class="day-label">night mode</span>
            <span class="night-label">day mode</span>
          </button>
        </div>
      </>
    )
  }
</aside>
