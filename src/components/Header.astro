---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? site.lang;
const marquee =
  "<marquee behavior=\"alternate\" scrollamount=\"2\">*** come on in, pull up a chair *** grab a snack *** stay as long as you like *** thanks for stopping by ***</marquee>";
---

<header class="site-header">
  <a href={getRelativeLocaleUrl(locale, "")} class="site-title">{site.title}</a>
  <p class="welcome">welcome to jeff's corner of the internet</p>
  <div class="marq" aria-hidden="true" set:html={marquee} />
  <p class="header-bits">
    <a href={getAssetPath("rss.xml")} title="rss feed">
      <img
        src={getAssetPath("buttons/rss.gif")}
        alt="rss feed"
        width="88"
        height="31"
      />
    </a>
    <button type="button" class="bookmark-btn" id="bookmark-hint" title="press ctrl+d to bookmark this site">
      <img
        src={getAssetPath("blinkies/bookmark-me.gif")}
        alt="press ctrl+d to bookmark this site"
        width="150"
        height="20"
      />
    </button>
  </p>
</header>
